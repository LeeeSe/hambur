<?xml version="1.0" encoding="utf-8"?>
<!--
  Hambur 启动图标前景：**直接复用**新建聊天页中间那只猫（@drawable/hambur_cat_mark），
  这里只负责"把它摆到图标该在的位置"，不再存第二份画。

  自适应图标画布是 108dp，系统只保证中间直径 66dp 的「安全圆」不被各种遮罩切掉
  （可见区 72dp）。所以四边各收 20dp，把猫放进中间 68dp 的方块：猫的墨迹约
  58×60dp，稳稳落在安全圆里。

  颜色在猫那个文件里（@color/ic_launcher_mark）：明主题黑猫白底、暗主题白猫黑底。
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/hambur_cat_mark"
    android:insetLeft="20dp"
    android:insetTop="20dp"
    android:insetRight="20dp"
    android:insetBottom="20dp" />
