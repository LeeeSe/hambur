namespace hambur_uniffi {
    BackendRuntime create_runtime(AppBootstrapConfig config);
};

dictionary AppBootstrapConfig {
    string app_files_dir;
    string native_library_dir;
};

dictionary CommandAck {
    string command_id;
    string idempotency_key;
    boolean accepted;
    boolean duplicate;
    string rejection_code;
    string message;
};

dictionary BackendCommand {
    string command_id;
    string idempotency_key;
    u64 created_at_ms;
    string kind;
    string session_id;
    string turn_id;
    string title;
    string message_id;
    string chunk;
    string content;
    string reasoning;
    string provider_id;
    string model_id;
    string source_message_id;
    string payload_json;
    boolean finalize;
};

dictionary BackendEvent {
    string event_id;
    u32 schema_version;
    u64 sequence;
    u64 created_at_ms;
    string kind;
    string session_id;
    string turn_id;
    AppSnapshotDTO snapshot;
    MarkdownRenderUpdateDTO markdown_render_update;
    PlatformRequestDTO platform_request;
    string error_code;
    string message;
};

dictionary PlatformRequestDTO {
    string request_id;
    string session_id;
    string turn_id;
    string kind;
    string payload_json;
    u64 timeout_ms;
    boolean cancellable;
};

dictionary MarkdownInlineNodeDTO {
    string kind;
    string text;
    string destination;
    string title;
    string alt;
    sequence<MarkdownInlineNodeDTO> children;
};

dictionary MarkdownTableRowDTO {
    sequence<string> cells;
};

dictionary MarkdownBlockNodeDTO {
    string message_id;
    u64 block_id;
    string stable_key;
    string source_kind;
    string node_kind;
    boolean committed;
    u8 level;
    sequence<MarkdownInlineNodeDTO> inlines;
    string language;
    string text;
    string raw;
    string children_json;
    string items_json;
    sequence<string> table_header;
    sequence<MarkdownTableRowDTO> table_rows;
    string path;
    string file_kind;
};

dictionary MarkdownRenderUpdateDTO {
    string message_id;
    boolean reset;
    sequence<MarkdownBlockNodeDTO> committed_nodes;
    MarkdownBlockNodeDTO? pending_node;
    sequence<u64> invalidated_block_ids;
};

dictionary MarkdownBlockPayloadDTO {
    string id;
    string session_id;
    string message_id;
    u64 block_id;
    string stable_key;
    boolean committed;
    MarkdownBlockNodeDTO node;
    string raw;
    string small_summary;
    u64 version_sequence;
    u64 created_at_ms;
    u64 updated_at_ms;
};

dictionary SessionSummaryDTO {
    string id;
    string title;
    string purpose;
    u64 created_at_ms;
    u64 updated_at_ms;
    u64 pinned_at_ms;
    boolean memory_reviewed;
    u32 message_count;
    string latest_preview;
};

dictionary TimelineItemDTO {
    string id;
    string stable_key;
    string content_type;
    u64 display_sequence;
    u64 version_sequence;
    string payload_ref;
    string small_summary;
    string kind;
    string trace_title;
    string trace_content;
    string trace_status;
    string tool_call_id;
    string tool_name;
    sequence<AttachmentDTO> attachments;
};

dictionary AttachmentDTO {
    string id;
    string session_id;
    string message_id;
    string kind;
    string display_name;
    string mime_type;
    u64 byte_size;
    string origin_type;
    string original_uri;
    string file_id;
    string sandbox_path;
    u32 width;
    u32 height;
    string sha256;
    string status;
    u64 created_at_ms;
    u64 updated_at_ms;
};

dictionary AppSnapshotDTO {
    sequence<SessionSummaryDTO> sessions;
    string selected_session_id;
    sequence<TimelineItemDTO> timeline_items;
    sequence<MarkdownBlockPayloadDTO> markdown_block_payloads;
    sequence<AttachmentDTO> pending_attachments;
};

dictionary PublicProviderDTO {
    string id;
    string name;
    string icon_name;
    string api_type;
    string base_url;
    string secret_label;
    boolean enabled;
    u64 created_at_ms;
    u64 updated_at_ms;
};

dictionary ProviderModelDTO {
    string id;
    string provider_id;
    string model_id;
    string display_name;
    boolean supports_tool_call;
    boolean supports_reasoning;
    boolean supports_image_input;
    boolean supports_structured_output;
    boolean supports_temperature;
    u32 context_limit;
    u32 output_limit;
    string reasoning_field;
    string metadata_json;
    u64 synced_at_ms;
};

dictionary ModelGroupDTO {
    string id;
    string name;
    string routing_strategy;
    string fallback_policy;
    u64 created_at_ms;
    u64 updated_at_ms;
};

dictionary ModelGroupMemberDTO {
    string id;
    string group_id;
    string provider_id;
    string provider_name;
    string model_id;
    string model_display_name;
    u32 position;
    boolean enabled;
};

dictionary DefaultModelGroupDTO {
    string key;
    string group_id;
    u64 updated_at_ms;
};

dictionary AppSettingDTO {
    string key;
    string value;
    u64 updated_at_ms;
};

dictionary ConfigAuditDTO {
    string id;
    string command_id;
    string actor;
    string action;
    string target_kind;
    string target_id;
    string redacted_summary;
    boolean approval_required;
    string approval_token;
    u64 created_at_ms;
};

dictionary SettingsSnapshotDTO {
    u64 snapshot_sequence;
    u64 created_at_ms;
    sequence<PublicProviderDTO> providers;
    sequence<ProviderModelDTO> provider_models;
    sequence<ModelGroupDTO> model_groups;
    sequence<ModelGroupMemberDTO> model_group_members;
    sequence<DefaultModelGroupDTO> default_model_groups;
    sequence<AppSettingDTO> settings;
    sequence<ConfigAuditDTO> config_audits;
};

dictionary SessionListSnapshotDTO {
    u64 snapshot_sequence;
    u64 created_at_ms;
    sequence<SessionSummaryDTO> sessions;
    string selected_session_id;
};

dictionary SessionSnapshotDTO {
    u64 snapshot_sequence;
    u64 created_at_ms;
    SessionSummaryDTO? session;
    sequence<TimelineItemDTO> timeline_items;
    sequence<MarkdownBlockPayloadDTO> markdown_block_payloads;
};

dictionary TimelinePageDTO {
    u64 snapshot_sequence;
    u64 created_at_ms;
    string session_id;
    sequence<TimelineItemDTO> items;
    sequence<MarkdownBlockPayloadDTO> markdown_block_payloads;
    u64 next_before_cursor;
    boolean has_more;
};

dictionary MessageDTO {
    string id;
    string session_id;
    string role;
    string content_text;
    string reasoning_content;
    string status;
    string turn_id;
    u64 created_at_ms;
    u64 version_sequence;
    string provider_id_snapshot;
    string provider_name_snapshot;
    string provider_protocol;
    string model_id_snapshot;
    string model_name_snapshot;
    string model_group_id;
    string finish_reason;
    string native_finish_reason;
    sequence<AttachmentDTO> attachments;
};

dictionary MessageSnapshotDTO {
    u64 snapshot_sequence;
    u64 created_at_ms;
    MessageDTO? message;
};

dictionary SearchSnapshotDTO {
    u64 snapshot_sequence;
    u64 created_at_ms;
    string query;
    sequence<SessionSummaryDTO> sessions;
};

dictionary FileResolutionDTO {
    string sandbox_path;
    string host_path;
    string relative_path;
    string root;
    boolean writable;
    boolean exists;
    boolean is_file;
    string mime_type;
    u64 byte_size;
    string file_id;
};

dictionary SkillSummaryDTO {
    string name;
    string description;
    string path;
    string category;
    sequence<string> tags;
    boolean built_in;
    boolean enabled;
    u64 created_at_ms;
    u64 modified_at_ms;
    sequence<string> files;
};

dictionary SkillDetailDTO {
    SkillSummaryDTO summary;
    string content;
    string raw_content;
    string skill_dir_path;
    string linked_files_json;
    string selected_file_path;
    string selected_file_content;
};

dictionary MemoryFileSummaryDTO {
    string name;
    u64 size_bytes;
    u64 modified_at_ms;
    u32 entry_count;
    string preview;
};

dictionary MemoryFileDetailDTO {
    string name;
    u64 size_bytes;
    u64 modified_at_ms;
    u32 entry_count;
    string content;
};

dictionary RootfsStatusDTO {
    boolean rootfs_installed;
    boolean proot_available;
    boolean root_available;
    boolean chroot_available;
    string backend;
    string version;
    u64 rootfs_size_bytes;
    string rootfs_path;
};

interface BackendRuntime {
    CommandAck dispatch(BackendCommand command);
    BackendEvent? next_event();
    SessionListSnapshotDTO get_session_list_snapshot(u32 limit, u32 offset);
    SessionSnapshotDTO get_session_snapshot(string session_id);
    TimelinePageDTO get_timeline_page(string session_id, u64 before_cursor, u32 limit);
    MessageSnapshotDTO get_message_snapshot(string message_id);
    SearchSnapshotDTO search_sessions(string query, u32 limit);
    SettingsSnapshotDTO get_settings_snapshot();
    FileResolutionDTO resolve_sandbox_file(string session_id, string sandbox_path);
    RootfsStatusDTO get_rootfs_status();
    sequence<SkillSummaryDTO> list_skills();
    SkillDetailDTO get_skill_detail(string identifier, string file_path);
    CommandAck delete_skill(string identifier);
    sequence<MemoryFileSummaryDTO> list_memory_files();
    MemoryFileDetailDTO get_memory_file_detail(string name);
    CommandAck create_session(string title);
    CommandAck open_session(string session_id);
    CommandAck delete_session(string session_id);
    CommandAck append_markdown_delta(string session_id, string message_id, string chunk, boolean finalize);
    sequence<MarkdownBlockNodeDTO> render_markdown_document(string message_id, string markdown);
    void shutdown();
};
